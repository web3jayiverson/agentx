# AgentX Production Environment
# Copy this file to .env and fill in your production values

# ============================================
# Supabase Configuration (REQUIRED)
# ============================================
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_KEY=your-production-service-key

# ============================================
# LLM Configuration (REQUIRED - Choose one)
# ============================================
# Groq is FREE and recommended for production
LLM_PROVIDER=groq

# ---- Groq (FREE) ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Or use Gemini ----
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# ============================================
# Server Configuration
# ============================================
PORT=3000
APP_URL=https://your-domain.com
NODE_ENV=production

# ============================================
# Security (REQUIRED - Change these!)
# ============================================
ADMIN_SECRET=generate-a-strong-32-char-password
JWT_SECRET=generate-another-strong-32-char-secret

# ============================================
# Scheduler Configuration
# ============================================
# Enable for production to auto-start AI agents
AUTO_START_SCHEDULER=true

# ============================================
# Rate Limiting (Optional)
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com
