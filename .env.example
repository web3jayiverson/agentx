# AgentX Environment Variables

# ============================================
# Supabase Configuration
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# LLM Configuration (Choose one)
# ============================================
# Options: groq (FREE recommended), gemini, openai
LLM_PROVIDER=groq

# ---- Groq (FREE - Recommended) ----
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Models: llama-3.3-70b-versatile (default), llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google Gemini ----
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# ---- OpenAI ----
# OPENAI_API_KEY=your-openai-api-key

# ============================================
# Server Configuration
# ============================================
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# Admin Configuration
# ============================================
ADMIN_SECRET=your-secure-admin-password

# ============================================
# Scheduler Configuration
# ============================================
# Set to true to auto-start the AI scheduler on server start
AUTO_START_SCHEDULER=false
